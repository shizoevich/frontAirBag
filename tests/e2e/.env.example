# ─── Site ─────────────────────────────────────────────────────────────────────
# URL of the running site (no trailing slash)
SITE_URL=https://dev.airbagad.com

# Locale prefix used in every URL  (en | ru | uk)
LOCALE=ru

# ─── Test accounts ────────────────────────────────────────────────────────────
# A regular test account (no Telegram linked)
SITE_TEST_EMAIL=test@example.com
SITE_TEST_PASSWORD=testpassword123

# A test account that already has a Telegram ID linked
# Used in test 02 (auto-auth as real user)
SITE_LINKED_EMAIL=linked@example.com
SITE_LINKED_PASSWORD=linkedpassword123

# ─── Telegram bot ─────────────────────────────────────────────────────────────
# Bot token from @BotFather – used to sign initData locally so the backend
# accepts it without needing a real Telegram session.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhiJklmNoPQrsTUVwxyz

# @username of the bot (without @), used to build t.me links
TELEGRAM_BOT_USERNAME=airbagshop_bot

# ─── Simulated Telegram users ─────────────────────────────────────────────────
# Telegram, якого немає в жодному акаунті: спека 01 очікує 404 і анонімний каталог.
# Ніколи не прив'язувати його руками — інакше спека 01 зламається.
TELEGRAM_UNKNOWN_USER_ID=111222333
TELEGRAM_UNKNOWN_USER_FIRST_NAME=TestUnknown
TELEGRAM_UNKNOWN_USERNAME=test_unknown_user

# Telegram, вже прив'язаний до SITE_LINKED_EMAIL (спека 02 — безшовний вхід)
TELEGRAM_LINKED_USER_ID=444555666

# Другий Telegram того ж акаунта SITE_LINKED_EMAIL. Спеки самі прив'язують його
# через API (auto-link ідемпотентний); має бути вільним при першому запуску.
TELEGRAM_SECOND_USER_ID=777888999

# Спека 03 реєструє новий акаунт на кожен прогін: свіжа пошта, свіжий телефон
# (+38044…), свіжий Telegram id. Записи лишаються в локальній базі — це нормально.

# ─── Real Telegram session (optional, only local) ─────────────────────────────
# Справжній міні-апп через Tailscale Funnel (scripts/webapp-local.sh) і ТЕСТОВИЙ бот.
# Один раз:  npm run test:e2e:setup   (код із SMS вводиться руками)
# Далі:      npx playwright test tests/e2e/specs/10-real-webapp.spec.ts --headed
TELEGRAM_PHONE=+380XXXXXXXXX
TELEGRAM_CLOUD_PASSWORD=
# @username тестового бота, у якого кнопка меню веде на Funnel-адресу фронту
TELEGRAM_TEST_BOT_USERNAME=

# ─── Backend API ──────────────────────────────────────────────────────────────
# Прямий доступ до бекенда — спека 06 сідає замовлення через API перед тестом
API_URL=http://localhost:8000

# Стенд через Funnel: локальный 443 занят другим сервером — направить Chromium на tailscale-адрес
# LOCAL_HOST_RESOLVER_RULES=MAP <host>.ts.net [<tailscale IPv6>]
